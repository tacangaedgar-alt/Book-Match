@model LoginViewModel
@{ViewData["Title"]="Iniciar sesión";}<div class="login-page"><section class="login-hero" aria-labelledby="hero-title"><div class="login-brand"><span class="brand-mark">★</span> BookMatch</div><div><h1 id="hero-title">Tu biblioteca digital,<br><em>ilimitada.</em></h1><p>Descubre libros que te apasionan, publica tus obras y conecta con lectores de todo el mundo.</p></div><div class="hero-stats"><div><strong>10,842</strong><span>Libros disponibles</span></div><div><strong>3,291</strong><span>Lectores activos</span></div><div><strong>847</strong><span>Autores registrados</span></div></div></section><section class="login-panel"><div class="login-card"><h2>Iniciar Sesión</h2><p>Accede a tu biblioteca personal</p><form asp-action="Login" method="post"><div asp-validation-summary="ModelOnly" class="validation" role="alert"></div><input asp-for="ReturnUrl" type="hidden"><label asp-for="Email">Correo electrónico</label><input asp-for="Email" placeholder="tu@email.com" autocomplete="email"><span asp-validation-for="Email"></span><label asp-for="Password">Contraseña</label><input asp-for="Password" placeholder="••••••••" autocomplete="current-password"><span asp-validation-for="Password"></span><button class="btn-primary wide" type="submit">Ingresar</button></form><div class="divider"><span>Acceso rápido (demo)</span></div><div class="demo-grid"><form asp-action="Demo" method="post"><input type="hidden" name="role" value="admin"><button class="btn-outline wide">Administrador</button></form><form asp-action="Demo" method="post"><input type="hidden" name="role" value="user"><button class="btn-outline gold wide">Usuario/Autor</button></form></div><small class="demo-hint">Contraseña demo: <code>password123</code></small></div></section></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
