@model UsersViewModel
@{ViewData["Title"]="Seguridad";}
<div class="page-heading"><div><h1>Seguridad del Sistema</h1><p>Gestión de usuarios, roles y sesiones de BookMatch</p></div></div><div class="tab-row"><a class="@(Model.Tab=="users"?"active":"")" asp-action="Users" asp-route-tab="users">Gestión de Usuarios</a><a class="@(Model.Tab=="roles"?"active":"")" asp-action="Security" asp-route-tab="roles">Roles y Permisos</a><a class="@(Model.Tab=="sessions"?"active":"")" asp-action="Security" asp-route-tab="sessions">Sesiones Activas</a></div>
@if(Model.Tab=="roles"){<div class="role-grid"><article class="panel"><h2>Administrador General</h2><p>Gestión de usuarios<br>Gestión de catálogo<br>Reportes completos<br>Seguridad del sistema<br>Configuración global</p></article><article class="panel"><h2>Usuario – Lector</h2><p>Cuestionario de preferencias<br>Ver catálogo<br>Comprar / Descargar libros<br>Acceder a Mi Biblioteca</p></article><article class="panel"><h2>Usuario – Escritor</h2><p>Todo lo anterior<br>Publicar libros<br>Editor de texto integrado<br>Ver estadísticas propias</p></article></div>}else if(Model.Tab=="sessions"){<div class="table-wrap"><table><thead><tr><th>Usuario</th><th>Rol</th><th>Inicio de sesión</th><th>Estado</th></tr></thead><tbody>@foreach(var u in Model.Users.Where(x=>x.Active)){<tr><td>@u.Name</td><td>@u.Role</td><td>@DateTime.Now.AddMinutes(-u.Id*7).ToString("g")</td><td><span class="status success">Activa</span></td></tr>}</tbody></table></div>}else{<form class="filter-panel" method="get"><input name="q" placeholder="Buscar usuario..."><button class="btn-primary">Buscar</button></form><div class="table-wrap"><table><thead><tr><th>Usuario</th><th>Correo</th><th>Rol</th><th>Libros pub.</th><th>Registrado</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>@foreach(var u in Model.Users){<tr><td><strong>@u.Name</strong></td><td>@u.Email</td><td><span class="tag">@u.Role</span></td><td>@u.Published</td><td>@u.Registered.ToString("d/M/yyyy")</td><td><span class="status @(u.Active?"success":"muted")">@(u.Active?"Activo":"Inactivo")</span></td><td>@if(u.Role!="Administrador"){<form asp-action="SetUserStatus" method="post"><input type="hidden" name="id" value="@u.Id"><input type="hidden" name="active" value="@(!u.Active)"><button class="btn-outline small">@(u.Active?"Desactivar":"Activar")</button></form>}</td></tr>}</tbody></table></div>}
