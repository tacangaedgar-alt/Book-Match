@model UsersViewModel
@{ ViewData["Title"]="Usuarios y seguridad"; var currentUserId=int.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier)!); }
<div class="page-heading"><div><h1>Usuarios y seguridad</h1><p>Administra perfiles, permisos, estados y sesiones reales de BookMatch.</p></div></div>
<div class="tab-row">
 <a class="@(Model.Tab=="users"?"active":"")" asp-action="Users" asp-route-tab="users">Gestión de usuarios</a>
 <a class="@(Model.Tab=="roles"?"active":"")" asp-action="Users" asp-route-tab="roles">Roles y permisos</a>
 <a class="@(Model.Tab=="sessions"?"active":"")" asp-action="Users" asp-route-tab="sessions">Sesiones activas (@Model.Sessions.Count)</a>
</div>
@if(Model.Tab=="roles"){
 <div class="role-grid"><article class="panel"><span class="role-icon">A</span><h2>Administrador</h2><p>Usuarios y seguridad<br>Catálogo global<br>Consultas y reportes<br>Cierre de sesiones</p></article><article class="panel"><span class="role-icon">LE</span><h2>Lector / Escritor</h2><p>Recomendaciones y catálogo<br>Compras, biblioteca y valoraciones<br>Publicación de libros<br>PDF originales y estadísticas propias</p></article></div>
}else if(Model.Tab=="sessions"){
 <div class="panel session-heading"><div><h2>Sesiones conectadas</h2><p>Una sesión cerrada perderá acceso en su próxima petición.</p></div><span class="status success">@Model.Sessions.Count activas</span></div>
 <div class="table-wrap"><table><thead><tr><th>Usuario</th><th>Correo</th><th>Rol</th><th>Inicio</th><th>Dirección IP</th><th>Estado</th><th>Acción</th></tr></thead><tbody>
 @foreach(var s in Model.Sessions){<tr><td><strong>@s.User</strong></td><td>@s.Email</td><td><span class="tag">@s.Role</span></td><td>@s.Started.ToString("g")</td><td><code>@(s.IpAddress??"No registrada")</code></td><td><span class="status success">Activa</span></td><td>@if(s.UserId==currentUserId){<span class="status muted">Sesión actual</span>}else{<form asp-action="CloseSession" method="post"><input type="hidden" name="id" value="@s.Id"><button class="btn-outline danger small">Cerrar sesión</button></form>}</td></tr>}
 @if(Model.Sessions.Count==0){<tr><td colspan="7"><div class="empty-state"><h2>No hay sesiones activas</h2><p>Las nuevas conexiones aparecerán aquí.</p></div></td></tr>}
 </tbody></table></div>
}else{
 <form class="filter-panel user-filter" method="get"><input type="hidden" name="tab" value="users"><input name="q" value="@Model.Query" placeholder="Buscar por nombre o correo..." aria-label="Buscar usuarios"><button class="btn-primary">Buscar</button>@if(!string.IsNullOrWhiteSpace(Model.Query)){<a class="btn-outline" asp-action="Users">Limpiar</a>}</form>
 <div class="table-wrap"><table><thead><tr><th>Usuario</th><th>Correo</th><th>Rol</th><th>Libros pub.</th><th>Registrado</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>
 @foreach(var u in Model.Users){<tr><td><strong>@u.Name</strong></td><td>@u.Email</td><td><span class="tag">@u.Role</span></td><td>@u.Published</td><td>@u.Registered.ToString("d/M/yyyy")</td><td><span class="status @(u.Active?"success":"muted")">@(u.Active?"Activo":"Inactivo")</span></td><td><div class="actions"><button class="btn-outline small" style="width:38px;padding:6px" type="button" data-modal-open="edit-user-@u.Id" title="Editar usuario" aria-label="Editar a @u.Name"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"/></svg></button>@if(u.Role!="Administrador"){<button class="btn-outline @(u.Active?"danger":"success") small" style="width:38px;padding:6px" type="button" data-modal-open="status-user-@u.Id" title="@(u.Active?"Desactivar usuario":"Activar usuario")" aria-label="@(u.Active?"Desactivar":"Activar") a @u.Name"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">@if(u.Active){<path d="M18 6 6 18M6 6l12 12"/>}else{<path d="m9 12 2 2 4-4"/><circle cx="12" cy="12" r="9"/>}</svg></button>}</div></td></tr>}
 </tbody></table></div>
 @foreach(var u in Model.Users){
  <div class="modal-shell" id="edit-user-@u.Id" hidden><div class="modal-card user-edit-card" role="dialog" aria-modal="true" aria-labelledby="edit-user-title-@u.Id"><button class="modal-close" type="button" data-modal-close aria-label="Cerrar">×</button><span class="eyebrow">PERFIL Y ACCESO</span><h2 id="edit-user-title-@u.Id">Editar usuario</h2><p>Actualiza sus datos y permisos de acceso.</p>
   <form asp-action="EditUser" method="post"><input type="hidden" name="Id" value="@u.Id"><div class="form-grid">
    <div class="full"><label for="name-@u.Id">Nombre completo</label><input id="name-@u.Id" name="Name" value="@u.Name" maxlength="120" required></div>
    <div class="full"><label for="email-@u.Id">Correo electrónico</label><input id="email-@u.Id" name="Email" type="email" value="@u.Email" maxlength="180" required></div>
    <div><label for="role-@u.Id">Rol</label><select id="role-@u.Id" name="Role" disabled="@(u.Id==currentUserId)">@if(u.Role=="Administrador"){<option value="Administrador" selected>Administrador</option>}else{<option value="Administrador">Administrador</option>}@if(u.Role=="Lector / Escritor"){<option value="Lector / Escritor" selected>Lector / Escritor</option>}else{<option value="Lector / Escritor">Lector / Escritor</option>}</select>@if(u.Id==currentUserId){<input type="hidden" name="Role" value="Administrador">}</div>
    <div><label for="status-@u.Id">Estado</label><select id="status-@u.Id" name="Active" disabled="@(u.Id==currentUserId)">@if(u.Active){<option value="true" selected>Activo</option><option value="false">Inactivo</option>}else{<option value="true">Activo</option><option value="false" selected>Inactivo</option>}</select>@if(u.Id==currentUserId){<input type="hidden" name="Active" value="true">}</div>
   </div><div class="publication-actions"><button class="btn-outline" type="button" data-modal-close>Cancelar</button><button class="btn-primary" type="submit">Guardar cambios</button></div></form>
  </div></div>
  @if(u.Role!="Administrador"){
   <div class="modal-shell" id="status-user-@u.Id" hidden><div class="modal-card" style="width:min(460px,100%);text-align:center" role="alertdialog" aria-modal="true" aria-labelledby="status-title-@u.Id"><button class="modal-close" type="button" data-modal-close aria-label="Cerrar">×</button><div class="quiz-star" aria-hidden="true">@(u.Active?"!":"✓")</div><h2 id="status-title-@u.Id">¿Confirmar @(u.Active?"desactivación":"activación")?</h2><p>@if(u.Active){<text>@u.Name perderá el acceso y sus sesiones abiertas se cerrarán.</text>}else{<text>@u.Name podrá volver a iniciar sesión y utilizar BookMatch.</text>}</p><form asp-action="SetUserStatus" method="post"><input type="hidden" name="id" value="@u.Id"><input type="hidden" name="operation" value="@(u.Active?"deactivate":"activate")"><div class="publication-actions"><button class="btn-outline" type="button" data-modal-close>Cancelar</button><button class="@(u.Active?"btn-danger":"btn-primary")" type="submit">Sí, @(u.Active?"desactivar":"activar")</button></div></form></div></div>
  }
 }
}
