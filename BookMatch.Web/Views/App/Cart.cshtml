@model List<CartItem>
@{ViewData["Title"]="Carrito";}<div class="page-heading"><div><h1>Carrito de Compras</h1><p>Revisa tus próximas lecturas</p></div></div>@if(Model.Count==0){<div class="empty-state panel"><span class="empty-icon">♧</span><h2>Tu carrito está vacío</h2><p>Explora el catálogo y agrega libros que te interesen.</p><a class="btn-primary" asp-action="Catalog">Explorar catálogo</a></div>}else{<div class="cart-layout"><div class="table-wrap"><table><thead><tr><th>Libro</th><th>Autor</th><th>Precio</th><th></th></tr></thead><tbody>@foreach(var item in Model){<tr><td><strong>@item.Title</strong></td><td>@item.Author</td><td>@item.Price.ToString("C")</td><td><form asp-action="RemoveFromCart" method="post"><input type="hidden" name="id" value="@item.BookId"><button class="btn-danger small">Quitar</button></form></td></tr>}</tbody></table></div><aside class="panel order-summary"><h2>Resumen</h2><div><span>Subtotal</span><strong>@Model.Sum(x=>x.Price).ToString("C")</strong></div><div><span>Total</span><strong>@Model.Sum(x=>x.Price).ToString("C")</strong></div><form asp-action="Checkout" method="post"><button class="btn-primary wide">Completar compra</button></form></aside></div>}
