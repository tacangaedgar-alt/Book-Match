@model LibraryViewModel
@{ViewData["Title"]="Mi Biblioteca";}
<div class="page-heading"><div><h1>Mi Biblioteca</h1><p>@Model.Books.Count libros en tu colección personal</p></div><div class="summary-chips"><span><b>@Model.Read</b> Leídos</span><span><b>@Model.Pending</b> Pendientes</span></div></div><div class="tab-row"><a class="@(Model.Filter=="all"?"active":"")" asp-route-filter="all">Todos</a><a class="@(Model.Filter=="read"?"active":"")" asp-route-filter="read">Leídos</a><a class="@(Model.Filter=="pending"?"active":"")" asp-route-filter="pending">Pendientes</a></div><div class="table-wrap"><table><thead><tr><th>Portada</th><th>Título</th><th>Autor</th><th>Género</th><th>Fecha</th><th>Precio</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>@foreach(var b in Model.Books){<tr><td><img class="mini-cover" src="@b.CoverUrl" alt=""></td><td><strong>@b.Title</strong><small>@b.Code</small></td><td>@b.Author</td><td><span class="tag">@b.Genre</span></td><td>@b.Date?.ToString("d/M/yyyy")</td><td>@(b.Price==0?"Gratis":b.Price.ToString("C"))</td><td><span class="status @(b.IsRead?"success":"warning")">@(b.IsRead?"Leído":"Pendiente")</span></td><td><button class="btn-primary small">Leer</button> <button class="btn-outline small">PDF</button></td></tr>}</tbody></table></div>
