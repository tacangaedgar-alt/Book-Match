@model PublicationViewModel
@{ViewData["Title"]="Mis Publicaciones";}
<div class="page-heading"><div><h1>Mis Publicaciones</h1><p>Gestiona tus obras literarias publicadas en BookMatch</p></div><button class="btn-primary" data-modal-open="publish-modal">+ Nuevo Libro</button></div><div class="tab-row"><a class="@(!Model.Statistics?"active":"")" asp-route-stats="false">Listado</a><a class="@(Model.Statistics?"active":"")" asp-route-stats="true">Estadísticas</a></div>
@if(Model.Statistics){<section class="metric-grid three"><article class="metric-card"><strong>@Model.Books.Count</strong><span>Total publicados</span></article><article class="metric-card"><strong>@Model.Revenue.ToString("C")</strong><span>Ventas totales</span></article><article class="metric-card"><strong>@Model.Downloads</strong><span>Total descargas</span></article></section><div class="panel"><h2>Ventas / Descargas por libro</h2><div class="horizontal-bars">@foreach(var b in Model.Books){<div><span>@b.Title</span><i style="width:@(Math.Min(100,b.Sales/30))%"></i><strong>@b.Sales</strong></div>}</div></div>}else{<div class="table-wrap"><table><thead><tr><th>Código</th><th>Portada</th><th>Título</th><th>Categoría</th><th>Precio</th><th>Estado</th><th>Ventas</th></tr></thead><tbody>@foreach(var b in Model.Books){<tr><td>@b.Code</td><td><img class="mini-cover" src="@b.CoverUrl" alt=""></td><td><strong>@b.Title</strong></td><td><span class="tag">@b.Genre</span></td><td>@(b.Price==0?"Gratis":b.Price.ToString("C"))</td><td><span class="status success">@b.Status</span></td><td>@b.Sales</td></tr>}</tbody></table></div>}
<div class="modal-shell" id="publish-modal" hidden><div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="publish-title"><button class="modal-close" type="button" data-modal-close aria-label="Cerrar">×</button><h2 id="publish-title">Publicar Nuevo Libro</h2><p>Completa la información de tu obra</p><form asp-action="Publish" method="post" enctype="multipart/form-data" data-submit-feedback><div class="form-grid"><div class="full"><label for="Pdf">Archivo PDF (máximo 50 MB)</label><input id="Pdf" name="Pdf" type="file" accept="application/pdf"></div><div><label for="Title">Título del libro *</label><input id="Title" name="Title" required maxlength="180"></div><div><label for="Genre">Categoría / Género *</label><select id="Genre" name="Genre" required><option value="">Seleccionar género</option>@foreach(var g in new[]{"Aventura","Ciencia Ficción","Drama","Ficción","Filosofía","Historia","No Ficción","Poesía","Romance","Thriller"}){<option>@g</option>}</select></div><div><label for="Language">Idioma</label><select id="Language" name="Language"><option>Español</option><option>Inglés</option></select></div><div><label for="Price">Precio (0 = gratis)</label><input id="Price" name="Price" type="number" step="0.01" min="0"></div><div class="full"><label for="Description">Descripción</label><textarea id="Description" name="Description" rows="3"></textarea></div><div class="full"><label for="Content">Contenido / notas</label><textarea id="Content" name="Content" rows="5"></textarea></div></div><button class="btn-primary wide" type="submit" data-submit-button>Publicar libro</button></form></div></div>
