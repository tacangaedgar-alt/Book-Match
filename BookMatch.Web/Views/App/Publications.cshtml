@model PublicationViewModel
@{ViewData["Title"]="Mis Publicaciones";}
<div class="page-heading"><div><h1>Mis Publicaciones</h1><p>Gestiona tus obras literarias publicadas en BookMatch</p></div><button class="btn-primary" data-modal-open="publish-modal">+ Nuevo Libro</button></div>
<div class="tab-row"><a class="@(!Model.Statistics?"active":"")" asp-route-stats="false">Listado</a><a class="@(Model.Statistics?"active":"")" asp-route-stats="true">Estadísticas</a></div>
@if(Model.Statistics)
{
 <section class="metric-grid three"><article class="metric-card"><strong>@Model.Books.Count</strong><span>Total publicados</span></article><article class="metric-card"><strong>@Model.Revenue.ToString("C")</strong><span>Ventas totales</span></article><article class="metric-card"><strong>@Model.Downloads</strong><span>Total descargas</span></article></section><div class="panel"><h2>Ventas / Descargas por libro</h2><div class="horizontal-bars">@foreach(var b in Model.Books){<div><span>@b.Title</span><i style="width:@(Math.Min(100,b.Sales/30))%"></i><strong>@b.Sales</strong></div>}</div></div>
}
else
{
 <div class="table-wrap"><table><thead><tr><th>Código</th><th>Portada</th><th>Título</th><th>Categoría</th><th>Precio</th><th>Estado</th><th>Ventas</th><th>Archivo</th></tr></thead><tbody>@foreach(var b in Model.Books){<tr><td>@b.Code</td><td><img class="mini-cover" src="@b.CoverUrl" alt="Portada de @b.Title"></td><td><strong>@b.Title</strong></td><td><span class="tag">@b.Genre</span></td><td>@(b.Price==0?"Gratis":b.Price.ToString("C"))</td><td><span class="status success">@b.Status</span></td><td>@b.Sales</td><td><div class="publication-file-actions">@if(b.HasPdf){<a class="btn-primary small" asp-action="PreviewPublication" asp-route-id="@b.Id">Vista previa</a><a class="btn-outline small" asp-action="PublicationPdf" asp-route-id="@b.Id" asp-route-download="true">Descargar PDF</a>}else{<span class="status muted">PDF no disponible</span>}</div></td></tr>}</tbody></table></div>
}
<div class="modal-shell publication-modal" id="publish-modal" hidden>
 <div class="modal-card publication-card" role="dialog" aria-modal="true" aria-labelledby="publish-title">
  <button class="modal-close" type="button" data-modal-close aria-label="Cerrar">×</button>
  <header class="publication-header"><span class="publication-mark" aria-hidden="true">B</span><div><span class="eyebrow">NUEVA PUBLICACIÓN</span><h2 id="publish-title">Publica tu próxima historia</h2><p>Sube los archivos y completa la ficha editorial.</p></div></header>
  <form asp-action="Publish" method="post" enctype="multipart/form-data" data-submit-feedback>
   <section class="upload-grid">
    <label class="upload-zone cover-upload" data-drop-zone>
     <input id="Cover" name="Cover" type="file" accept="image/jpeg,image/png,image/webp" required data-cover-input>
     <span class="cover-preview" data-cover-preview><i aria-hidden="true"></i><strong>Portada del libro *</strong><small>Arrastra una imagen o haz clic</small><em>JPG, PNG o WEBP · máx. 5 MB</em></span>
    </label>
    <label class="upload-zone pdf-upload" data-drop-zone>
     <input id="Pdf" name="Pdf" type="file" accept="application/pdf,.pdf" required data-pdf-input>
     <span class="upload-icon" aria-hidden="true">PDF</span><strong>Archivo del libro *</strong><small data-file-label>Arrastra tu PDF o haz clic para seleccionarlo</small><em>Documento PDF · máx. 50 MB</em>
    </label>
   </section>
   <div class="publication-divider"><span>Información editorial</span></div>
   <div class="form-grid publication-form"><div><label for="Title">Título del libro *</label><input id="Title" name="Title" required maxlength="180" placeholder="Ej. El jardín de medianoche"></div><div><label for="Genre">Categoría / Género *</label><select id="Genre" name="Genre" required><option value="">Seleccionar género</option>@foreach(var g in new[]{"Aventura","Ciencia Ficción","Drama","Ficción","Filosofía","Historia","No Ficción","Poesía","Romance","Thriller"}){<option>@g</option>}</select></div><div><label for="Language">Idioma *</label><select id="Language" name="Language" required><option>Español</option><option>Inglés</option></select></div><div><label for="Price">Precio <small>(0 = gratis)</small></label><input id="Price" name="Price" type="number" step="0.01" min="0" value="0"></div><div class="full"><label for="Description">Descripción</label><textarea id="Description" name="Description" rows="3" maxlength="2000" placeholder="Presenta el libro a tus futuros lectores..."></textarea></div><div class="full"><label for="Content">Notas adicionales</label><textarea id="Content" name="Content" rows="3" placeholder="Información opcional sobre la obra"></textarea></div></div>
   <footer class="publication-actions"><button class="btn-outline" type="button" data-modal-close>Cancelar</button><button class="btn-primary" type="submit" data-submit-button>Publicar libro</button></footer>
  </form>
 </div>
</div>
