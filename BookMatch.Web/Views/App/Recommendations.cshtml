@model RecommendationViewModel
@{ViewData["Title"]="Recomendaciones";}
@if(Model.HasResults)
{
 <div class="page-heading"><div><h1>Lecturas recomendadas para ti</h1><p>Estas coincidencias se cargaron usando las preferencias guardadas en tu perfil.</p></div><a class="btn-outline" asp-action="Recommendations" asp-route-edit="true">Cambiar mis preferencias</a></div>
 <div class="preference-summary"><span>Género: <strong>@Model.Preferences.Genre</strong></span><span>Idioma: <strong>@Model.Preferences.Language</strong></span><span>Formato: <strong>@Model.Preferences.Format</strong></span></div>
 <section class="book-grid">@foreach(var book in Model.Books){<article class="book-card"><div class="book-cover" style="background-image:url('@book.CoverUrl')"><span class="affinity-badge">@book.Affinity% afinidad</span>@if(book.IsOwnPublication){<span class="owned-badge own-publication">Tu publicación</span>}else if(book.IsInLibrary){<span class="owned-badge">En tu biblioteca</span>}</div><div class="book-info"><span class="tag">@book.Genre</span><h2>@book.Title</h2><p>@book.Author · @book.Language</p><div class="rating">★ @book.Rating.ToString("0.0") <small>(@book.RatingCount)</small></div>@if(book.IsOwnPublication){<button class="btn-outline wide" type="button" disabled>No puedes comprar tu publicación</button>}else if(book.IsInLibrary){<button class="btn-primary wide" type="button" disabled>Ya está en tu biblioteca</button>}else if(book.IsInCart){<button class="btn-outline wide" type="button" disabled>Ya está en tu carrito</button>}else{<form asp-action="AddToCart" method="post"><input type="hidden" name="id" value="@book.Id"><button class="btn-primary wide">@(book.Price==0?"Añadir a biblioteca":"Añadir al carrito")</button></form>}</div></article>}</section>
 @if(Model.Books.Count==0){<div class="empty-state panel"><h2>Aún no hay coincidencias</h2><p>Publica más libros o repite el cuestionario con otras preferencias.</p></div>}
}
else
{
 <div class="recommendation" data-quiz><section class="quiz-intro panel"><span class="quiz-star">☆</span><h1>Descubre tu próxima lectura</h1><p>Responde siete preguntas. Guardaremos tus preferencias y compararemos tus respuestas con el catálogo de BookMatch.</p><div class="quiz-benefits"><span>✓ 7 preguntas</span><span>✓ Preferencias guardadas</span></div><button class="btn-primary" type="button" data-quiz-start>Comenzar cuestionario →</button></section>
  <form asp-action="Recommendations" method="post" data-recommendation-form><input type="hidden" name="Genre" data-answer="Genre"><input type="hidden" name="PagePreference" data-answer="PagePreference"><input type="hidden" name="Language" data-answer="Language"><input type="hidden" name="Format" data-answer="Format"><input type="hidden" name="Pace" data-answer="Pace"><input type="hidden" name="Mood" data-answer="Mood"><input type="hidden" name="Discovery" data-answer="Discovery">
   <section class="quiz-card panel" hidden><div class="progress-meta"><span data-step-label>Pregunta 1 de 7</span><span data-progress-label>0% completado</span></div><div class="progress"><i data-progress></i></div><h2 data-question></h2><div class="quiz-options" data-options></div><button class="btn-link" type="button" data-back>← Pregunta anterior</button></section>
   <section class="quiz-results panel" hidden><span class="quiz-star">✓</span><h1>Preferencias completadas</h1><p>Ya podemos calcular tus coincidencias usando los libros de la base de datos.</p><button class="btn-primary" type="submit" data-submit-button>Generar mis recomendaciones</button><button class="btn-link" type="button" data-back-final>← Cambiar última respuesta</button></section>
  </form>
 </div>
}
