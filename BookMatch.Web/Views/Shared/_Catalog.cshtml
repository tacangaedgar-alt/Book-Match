@model CatalogViewModel
<section class="book-grid">
@foreach(var book in Model.Books){
 <article class="book-card"><div class="book-cover" style="background-image:url('@book.CoverUrl')"><span class="price-badge">@(book.Price==0?"Gratis":book.Price.ToString("C"))</span>@if(book.IsOwnPublication){<span class="owned-badge own-publication">Tu publicación</span>}else if(book.IsInLibrary){<span class="owned-badge">En tu biblioteca</span>}</div>
 <div class="book-info"><span class="tag">@book.Genre</span><h2>@book.Title</h2><p>@book.Author</p><div class="rating" aria-label="Valoración @book.Rating de 5, basada en @book.RatingCount opiniones">★ @book.Rating.ToString("0.0") <small>(@book.RatingCount)</small></div>
 @if(!User.IsInRole("Administrador")){if(book.IsOwnPublication){<a class="btn-outline wide" asp-controller="App" asp-action="Publications">Administrar publicación</a>}else if(book.IsInLibrary){<button class="btn-primary wide" type="button" disabled>Ya está en tu biblioteca</button>}else if(book.IsInCart){<button class="btn-outline wide" type="button" disabled>Ya está en tu carrito</button>}else{<form asp-controller="App" asp-action="AddToCart" method="post"><input type="hidden" name="id" value="@book.Id"><button class="btn-primary wide">@(book.Price==0?"Añadir a biblioteca":"Añadir al carrito")</button></form>}}</div></article>
}
</section>
