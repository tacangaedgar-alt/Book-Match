@model CatalogViewModel
@{var controller=User.IsInRole("Administrador")?"Admin":"App";}
<div class="page-heading"><div><h1>Catálogo de Libros</h1><p>@Model.Books.Count títulos disponibles</p></div></div>
<form class="filter-panel" asp-controller="@controller" asp-action="Catalog" method="get"><label class="sr-only" for="q">Buscar</label><input id="q" name="q" value="@Model.Query" placeholder="Buscar por título o autor..."><select name="genre" aria-label="Género"><option value="">Todos los géneros</option>@foreach(var g in new[]{"Aventura","Ciencia Ficción","Drama","Ficción","Filosofía","Historia","No Ficción","Poesía","Romance","Thriller"}){<option selected="@(Model.Genre==g)">@g</option>}</select><select name="language" aria-label="Idioma"><option value="">Todos los idiomas</option><option selected="@(Model.Language=="Español")">Español</option><option selected="@(Model.Language=="Inglés")">Inglés</option></select><select name="priceType" aria-label="Precio"><option value="all" selected="@(Model.PriceType=="all")">Todos</option><option value="free" selected="@(Model.PriceType=="free")">Gratis</option><option value="paid" selected="@(Model.PriceType=="paid")">De pago</option></select><button class="btn-primary">Filtrar</button></form>
<section class="book-grid">@foreach(var book in Model.Books){<article class="book-card"><div class="book-cover" style="background-image:url('@book.CoverUrl')"><span class="price-badge">@(book.Price==0?"Gratis":book.Price.ToString("C"))</span>@if(book.IsInLibrary){<span class="owned-badge">En tu biblioteca</span>}</div><div class="book-info"><span class="tag">@book.Genre</span><h2>@book.Title</h2><p>@book.Author</p><div class="rating" aria-label="Valoración @book.Rating de 5">★ @book.Rating</div>@if(!User.IsInRole("Administrador")){if(book.IsInLibrary){<button class="btn-primary wide" type="button" disabled aria-label="@book.Title ya está en tu biblioteca">Ya está en tu biblioteca</button>}else if(book.IsInCart){<button class="btn-outline wide" type="button" disabled aria-label="@book.Title ya está en el carrito">Ya está en el carrito</button>}else{<form asp-controller="App" asp-action="AddToCart" method="post"><input type="hidden" name="id" value="@book.Id"><button class="btn-primary wide">@(book.Price==0?"Añadir a biblioteca":"Añadir al carrito")</button></form>}}</div></article>}</section>
@if(Model.Books.Count==0){<div class="empty-state"><h2>No encontramos libros</h2><p>Prueba con otros filtros o términos de búsqueda.</p></div>}
