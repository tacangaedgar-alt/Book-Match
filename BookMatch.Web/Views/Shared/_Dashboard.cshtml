@model DashboardViewModel
<div class="page-heading"><div><h1>@Model.Title</h1><p>Resumen de actividad de BookMatch — @DateTime.Now.ToString("dddd, d 'de' MMMM 'de' yyyy")</p></div><span class="date-chip">▣ @DateTime.Now.ToString("MMMM yyyy")</span></div><section class="metric-grid">@foreach(var m in Model.Metrics){<article class="metric-card"><span class="metric-icon @m.Tone">@m.Icon</span><div><strong>@m.Value</strong><span>@m.Label</span><small>@m.Detail</small></div></article>}</section><section class="dashboard-grid"><article class="panel chart-panel"><h2>Ventas y Descargas por Mes</h2><p>Ingresos (USD) y descargas gratuitas</p><div class="bar-chart" role="img" aria-label="Gráfico mensual de ventas">@foreach(var p in Model.Monthly){var h=Math.Max(8,(double)p.Sales/120);<div class="bar-item"><i style="height:@(h)px"></i><span>@p.Month</span></div>}</div></article><article class="panel"><h2>Libros por Género</h2><p>Distribución del catálogo</p><div class="genre-list">@foreach(var g in Model.Genres){<div><span>@g.Genre</span><strong>@g.Total</strong></div>}</div></article></section>
