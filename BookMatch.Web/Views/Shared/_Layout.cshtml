<!DOCTYPE html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/><title>@ViewData["Title"] · BookMatch</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head><body>
@if(User.Identity?.IsAuthenticated==true){var admin=User.IsInRole("Administrador");var controller=admin?"Admin":"App";var action=ViewContext.RouteData.Values["action"]?.ToString();
<a class="skip-link" href="#main-content">Saltar al contenido</a><div class="app-shell"><aside class="sidebar" id="sidebar"><a class="brand" asp-controller="@controller" asp-action="Dashboard"><span class="brand-mark">★</span><span>BookMatch</span></a><div class="role-pill">@(admin?"Administrador General":"Lector / Escritor")</div><nav aria-label="Navegación principal">
<a class="nav-link @(action=="Dashboard"?"active":"")" asp-controller="@controller" asp-action="Dashboard"><span>▦</span> Dashboard</a>@if(!admin){<a class="nav-link @(action=="Recommendations"?"active":"")" asp-controller="App" asp-action="Recommendations"><span>☆</span> Recomendaciones</a>}<a class="nav-link @(action=="Catalog"?"active":"")" asp-controller="@controller" asp-action="Catalog"><span>▤</span> Catálogo</a>
@if(!admin){<a class="nav-link @(action=="Library"?"active":"")" asp-controller="App" asp-action="Library"><span>□</span> Mi Biblioteca</a><a class="nav-link @(action=="Publications"?"active":"")" asp-controller="App" asp-action="Publications"><span>✎</span> Mis Publicaciones</a><a class="nav-link @(action=="Cart"?"active":"")" asp-controller="App" asp-action="Cart"><span>♧</span> Carrito</a>}else{<a class="nav-link @(action=="Users"?"active":"")" asp-controller="Admin" asp-action="Users"><span>♙</span> Usuarios</a>}<a class="nav-link @(action=="Queries"?"active":"")" asp-controller="@controller" asp-action="Queries"><span>⌕</span> Consultas</a><a class="nav-link @(action=="Reports"?"active":"")" asp-controller="@controller" asp-action="Reports"><span>▥</span> Reportes</a>@if(admin){<a class="nav-link @(action=="Security"?"active":"")" asp-controller="Admin" asp-action="Security"><span>♢</span> Seguridad</a>}</nav>
<div class="sidebar-user"><span class="avatar">@User.Identity.Name?[0]</span><span><strong>@User.Identity.Name</strong><small>@(admin?"Administrador":"Lector / Escritor")</small></span><form asp-controller="Account" asp-action="Logout" method="post"><button class="icon-button" aria-label="Cerrar sesión">↪</button></form></div></aside><div class="app-column"><header class="topbar"><button class="menu-button" type="button" data-sidebar-toggle aria-label="Abrir menú">☰</button><span class="eyebrow">BOOKMATCH PLATFORM</span><div class="top-user"><span>@User.Identity.Name</span><span class="avatar">@User.Identity.Name?[0]</span></div></header><main id="main-content" class="content" tabindex="-1">@if(TempData["Success"] is string ok){<div class="toast-message success" role="status">@ok</div>}@if(TempData["Error"] is string error){<div class="toast-message error" role="alert">@error</div>}@RenderBody()</main></div></div>
}else{<main>@RenderBody()</main>}<script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
