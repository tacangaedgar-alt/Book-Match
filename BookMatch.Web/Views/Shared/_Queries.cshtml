@model QueryViewModel
@{var controller=User.IsInRole("Administrador")?"Admin":"App";}
<div class="page-heading"><div><h1>Consultas</h1><p>Explora información detallada del catálogo y transacciones</p></div></div><div class="tab-row wrap"><a class="@(Model.Tab=="author"?"active":"")" asp-controller="@controller" asp-action="Queries" asp-route-tab="author">Por Autor</a><a class="@(Model.Tab=="purchases"?"active":"")" asp-controller="@controller" asp-action="Queries" asp-route-tab="purchases">Historial de Compras</a><a class="@(Model.Tab=="genre"?"active":"")" asp-controller="@controller" asp-action="Queries" asp-route-tab="genre">Por Género/Categoría</a><a class="@(Model.Tab=="sales"?"active":"")" asp-controller="@controller" asp-action="Queries" asp-route-tab="sales">Ventas por Escritor</a></div>
@if(Model.Tab=="purchases"){<div class="table-wrap"><table><thead><tr><th>Código</th><th>Usuario</th><th>Libro</th><th>Autor</th><th>Fecha</th><th>Monto</th><th>Estado</th></tr></thead><tbody>@foreach(var p in Model.Purchases){<tr><td>@p.Code</td><td>@p.User</td><td>@p.Book</td><td>@p.Author</td><td>@p.Date.ToString("d/M/yyyy")</td><td>@p.Amount.ToString("C")</td><td><span class="status @(p.Status=="Leído"?"success":"warning")">@p.Status</span></td></tr>}</tbody></table></div>}else{var groups=Model.Tab=="genre"?Model.Books.GroupBy(x=>x.Genre):Model.Books.GroupBy(x=>x.Author);<div class="group-grid">@foreach(var group in groups){<article class="panel"><h2>@group.Key</h2><p>@group.Count() libro(s)</p>@foreach(var b in group.Take(4)){<div class="query-book"><img src="@b.CoverUrl" alt=""><span><strong>@b.Title</strong><small>@b.Price.ToString("C") · @b.Sales ventas</small></span></div>}</article>}</div>}
