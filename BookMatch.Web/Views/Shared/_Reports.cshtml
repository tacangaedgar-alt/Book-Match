@model PublicationViewModel
<div class="page-heading"><div><h1>Reportes</h1><p>Análisis detallado de la plataforma BookMatch</p></div><div class="actions"><button class="btn-outline danger" onclick="window.print()">Exportar PDF</button><button class="btn-outline success" data-export-table>Exportar Excel/CSV</button></div></div><section class="metric-grid"><article class="metric-card"><strong>@Model.Books.Count</strong><span>Total publicados</span></article><article class="metric-card"><strong>@Model.Books.Count(x=>x.Price==0)</strong><span>Gratuitos</span></article><article class="metric-card"><strong>@Model.Books.Count(x=>x.Price>0)</strong><span>De pago</span></article><article class="metric-card"><strong>@Model.Books.Sum(x=>x.Sales)</strong><span>Ventas</span></article></section><div class="tab-row"><span class="active">Libros Publicados</span><span>Ventas por Período</span><span>Más Vendidos</span><span>Por Autor</span></div><div class="table-wrap"><table id="report-table"><thead><tr><th>Código</th><th>Título</th><th>Autor</th><th>Género</th><th>Precio</th><th>Ventas</th><th>Estado</th></tr></thead><tbody>@foreach(var b in Model.Books){<tr><td>@b.Code</td><td>@b.Title</td><td>@b.Author</td><td>@b.Genre</td><td>@b.Price</td><td>@b.Sales</td><td>@b.Status</td></tr>}</tbody></table></div>
