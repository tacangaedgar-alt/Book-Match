@model PublicationViewModel
@{
    var authors=Model.Books.GroupBy(x=>x.Author).OrderByDescending(x=>x.Sum(y=>y.Sales)).Select(x=>new{Name=x.Key,Books=x.Count(),Sales=x.Sum(y=>y.Sales),Revenue=x.Sum(y=>y.Price*y.Sales)}).ToList();
    var bestEight=Model.Books.OrderByDescending(x=>x.Sales).ThenBy(x=>x.Title).Take(8).ToList();
    var maxSales=Math.Max(1,bestEight.Count==0?1:bestEight.Max(x=>x.Sales));
    var firstSale=Model.Purchases.Count==0?DateTime.Today.AddMonths(-11):Model.Purchases.Min(x=>x.Date).Date;
    var lastSale=Model.Purchases.Count==0?DateTime.Today:Model.Purchases.Max(x=>x.Date).Date;
    var salesJson=System.Text.Json.JsonSerializer.Serialize(Model.Purchases.Select(x=>new{date=x.Date.ToString("yyyy-MM-dd"),amount=x.Amount}));
}
<div class="report-module" data-reports>
 <div class="page-heading"><div><h1>Reportes</h1><p>Análisis detallado de la plataforma BookMatch</p></div><div class="actions report-actions"><button type="button" class="btn-outline danger" data-export-pdf>Exportar PDF</button><button type="button" class="btn-outline success" data-export-excel>Exportar Excel</button></div></div>
 <section class="metric-grid"><article class="metric-card"><strong>@Model.Books.Count</strong><span>Total publicados</span></article><article class="metric-card"><strong>@Model.Books.Count(x=>x.Price==0)</strong><span>Gratuitos</span></article><article class="metric-card"><strong>@Model.Books.Count(x=>x.Price>0)</strong><span>De pago</span></article><article class="metric-card"><strong>@Model.Books.Sum(x=>x.Sales)</strong><span>Ventas</span></article></section>
 <div class="tab-row report-tabs" role="tablist" aria-label="Tipos de reporte"><button type="button" class="active" role="tab" aria-selected="true" aria-controls="report-books" data-report-tab="report-books">Libros publicados</button><button type="button" role="tab" aria-selected="false" aria-controls="report-periods" data-report-tab="report-periods">Ventas por período</button><button type="button" role="tab" aria-selected="false" aria-controls="report-best" data-report-tab="report-best">Más vendidos</button><button type="button" role="tab" aria-selected="false" aria-controls="report-authors" data-report-tab="report-authors">Por autor</button></div>
 <section id="report-books" data-report-panel data-report-name="Libros-publicados" role="tabpanel"><div class="table-wrap"><table><thead><tr><th>Código</th><th>Título</th><th>Autor</th><th>Género</th><th>Precio</th><th>Ventas</th><th>Estado</th></tr></thead><tbody>@foreach(var b in Model.Books){<tr><td>@b.Code</td><td>@b.Title</td><td>@b.Author</td><td>@b.Genre</td><td>@b.Price.ToString("0.00")</td><td>@b.Sales</td><td>@b.Status</td></tr>}</tbody></table></div></section>
 <section id="report-periods" data-report-panel data-report-name="Ventas-por-periodo" role="tabpanel" hidden>
  <script type="application/json" data-sales-json>@Html.Raw(salesJson)</script>
  <form class="report-filter-card" data-sales-filter><div><label for="sales-from">Desde</label><input id="sales-from" type="date" value="@firstSale.ToString("yyyy-MM-dd")" max="@lastSale.ToString("yyyy-MM-dd")"></div><div><label for="sales-to">Hasta</label><input id="sales-to" type="date" value="@lastSale.ToString("yyyy-MM-dd")" min="@firstSale.ToString("yyyy-MM-dd")"></div><button class="btn-primary" type="submit">Aplicar filtro</button><button class="btn-outline" type="button" data-sales-reset>Restablecer</button></form>
  <div class="report-summary-grid"><article><strong data-sales-total>0.00</strong><span>Ingresos totales</span></article><article><strong data-sales-count>0</strong><span>Transacciones</span></article><article><strong data-sales-average>0.00</strong><span>Promedio por venta</span></article></div>
  <div class="chart-panel"><div class="chart-title"><div><h2>Ingresos por período</h2><p data-sales-range></p></div><span class="chart-legend"><i></i> Ingresos</span></div><div class="line-chart" data-line-chart role="img" aria-label="Gráfico lineal de ingresos por período"></div></div>
  <div class="table-wrap report-data-table"><table><thead><tr><th>Período</th><th>Operaciones</th><th>Importe vendido</th></tr></thead><tbody data-sales-table></tbody></table></div>
 </section>
 <section id="report-best" data-report-panel data-report-name="Libros-mas-vendidos" role="tabpanel" hidden>
  <div class="chart-panel"><div class="chart-title"><div><h2>Top 8 libros más vendidos</h2><p>Ranking calculado con las ventas registradas</p></div><span class="chart-legend purple"><i></i> Ventas</span></div><div class="bar-ranking-chart" role="img" aria-label="Gráfico de barras de los ocho libros más vendidos">@foreach(var b in bestEight){var height=Math.Max(4,(int)Math.Round(b.Sales*100d/maxSales));<div class="bar-column"><span class="bar-value">@b.Sales</span><i style="--bar-height:@height%"></i><small title="@b.Title">@b.Title</small></div>}</div></div>
  <div class="ranking-panel"><h2>Ranking de más vendidos</h2><div class="ranking-list">@foreach(var item in bestEight.Select((book,index)=>new{Book=book,Position=index+1})){var tone=item.Position==1?"gold":item.Position==2?"silver":item.Position==3?"bronze":"standard";<article><span class="rank-medal @tone" aria-label="Posición @item.Position"><i></i><b>@item.Position</b></span><img src="@item.Book.CoverUrl" alt="Portada de @item.Book.Title" loading="lazy"><div><strong>@item.Book.Title</strong><small>@item.Book.Author</small></div><span class="ranking-sales"><b>@item.Book.Sales</b> ventas</span></article>}</div></div>
  <div class="table-wrap report-data-table"><table><thead><tr><th>Posición</th><th>Libro</th><th>Autor</th><th>Precio</th><th>Ventas</th><th>Ingresos estimados</th></tr></thead><tbody>@foreach(var item in bestEight.Select((book,index)=>new{Book=book,Position=index+1})){<tr><td>#@item.Position</td><td>@item.Book.Title</td><td>@item.Book.Author</td><td>@item.Book.Price.ToString("0.00")</td><td>@item.Book.Sales</td><td>@((item.Book.Price*item.Book.Sales).ToString("0.00"))</td></tr>}</tbody></table></div>
 </section>
 <section id="report-authors" data-report-panel data-report-name="Reporte-por-autor" role="tabpanel" hidden><div class="table-wrap"><table><thead><tr><th>Autor</th><th>Libros publicados</th><th>Ventas</th><th>Ingresos estimados</th></tr></thead><tbody>@foreach(var author in authors){<tr><td>@author.Name</td><td>@author.Books</td><td>@author.Sales</td><td>@author.Revenue.ToString("0.00")</td></tr>}</tbody></table></div></section>
</div>
